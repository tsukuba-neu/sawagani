    "@types/node": "22.7.4",
    "@types/papaparse": "5.3.16",
    "@vite-pwa/assets-generator": "1.0.1",
    "@vitejs/plugin-vue": "6.0.1",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
