{
  "name": "@tsukuba-neu/sawagani",
  "version": "0.0.0",
  "description": "Generate accounting report format from CSV data",
  "author": "Kazumi Inada <hello@nandenjin.com>",
  "private": true,
  "keywords": [],
  "main": "index.html",
  "type": "module",
  "repository": {
